{
  "name": "jacob-gil-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "node scripts/verify.mjs",
    "format": "prettier --write src scripts package.json README.md .github/workflows/pages.yml",
    "format:check": "prettier --check src scripts package.json README.md .github/workflows/pages.yml"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "sharp": "0.35.5"
  }
}
